static func get_weapon_data(weapon_id: String) -> Dictionary:
	return preload("res://scripts/core/swarm_balance.gd").apply("weapons", weapon_id, weapons.get(weapon_id, {}))

static func get_all_weapon_ids() -> Array[String]:
	var keys: Array[String] = []
	for k in weapons.keys():
		keys.append(k)
	return keys

static func get_general_weapon_ids() -> Array[String]:
	var keys: Array[String] = []
	for k in weapons.keys():
		if not k in ["weapon_meow_meow", "weapon_sound_wave", "weapon_shield_slam", "weapon_tentacle_slam", "weapon_pillory_swipe", "weapon_steel_tempest", "weapon_bunny_hop", "weapon_guiding_hex", "weapon_winged_dagger"]:
			keys.append(k)
	return keys
